.PROGRAM maze()


        ATTACH ()
        SPEED 5 MONITOR

        MOVES labyrint[0]
        BREAK
        WAIT.EVENT 0.2

;Steg 1
        summa_y = -85
        summa_x = 0

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 30
; Steg 2

        summa_y = summa_y+0
        summa_x = summa_x+60

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BRAKE
        WAIT.EVENT 30
; Steg 3

        summa_y = summa_y+(-100)
        summa_x = summa_x+0

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 0.2
; Steg 4

        summa_y = summa_y+0
        summa_x = summa_x+(-95)

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 0.2
; Steg 5

        summa_y = summa_y+(-85)
        summa_x = summa_x+0

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 0.2
; Steg 6

        summa_y = summa_y+0
        summa_x = summa_x+105

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 0.2

; Steg 7 

        summa_y = summa_y+(-180)
        summa_x = summa_x+0

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 0.2

; Steg 8 
        summa_y = summa_y+0
        summa_x = summa_x+(-115)

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 0.2
; Steg 9 

        summa_y = summa_y+(-150)
        summa_x = summa_x+0

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVES flytta
        BREAK
        WAIT.EVENT 0.2














.END

