.PROGRAM main()
        CALL init() ; Tar in startvärden

; Locations till pickframe
        SET frame1[0] = TRANS(39.252,279.681,52.010,0.000,180.000,-0.013)
        SET frame1[1] = TRANS(39.252,229.681,52.005,0.000,180.000,-0.013) ;LOcation 2
        SET frame1[2] = TRANS(-60.748,279.681,52.010,0.000,180.000,-0.013) ; Location 3

; Skapar pickframe
        SET pickframe = FRAME(frame1[0],frame1[1],frame1[2],frame1[0])
; LOcations till placeframe
; Måste ha ~-45 grader förskjutning i roll
        SET frame2[0] = TRANS(13.745,-189.407,52.000,0.000,180.000,-89.840)
        SET frame2[1] = TRANS(13.745,-239.407,52.000,0.000,180.000,-89.840)
        SET frame2[2] = TRANS(-86.255,-18.407,52.000,0.000,180.000,-89.840)
; Skapar placeframe
        SET placeframe = FRAME(frame2[0],frame2[1],frame2[2],frame2[0])
; Loop
        WHILE arbete DO
            SET pick = pickframe:TRANS(x*x_avs,y*y_avs) ; Förskjutning från pickframe (origin)
            SET place = placeframe:TRANS(x*x_avs,y*y_avs) ; Förskjutning från placeframe (origin)


; Pick
            RIGHTY ; För att nå på sin vänstra sida
            BREAK

            APPROS pick, 30
            CALL gripper(open)
            MOVE pick
            BREAK
            WAIT.EVENT 0.2
            CALL gripper(close)
            DEPART 30

;Labyrint Pick-Place
            FOR i = 0 TO 13
                MOVES loc[i]
                BREAK
                WAIT.EVENT 0.5
            END


; Place
            LEFTY ; För att nå sin höger sida
            BREAK

            APPRO place, 30
            MOVE place
            BREAK
            WAIT.EVENT 0.2
            CALL gripper(open)
            DEPART 30

; Labyrint Place-Pick

            FOR i = 13 TO 0 STEP -1
                MOVES loc[i]
                BREAK
                WAIT.EVENT 0.5
            END
; Uppräknare för förskjutning i X och Y axel för Pick/place-frame
            x = x+1
            IF x > x_grid THEN
                x = 0
                y = y+1
            END
            IF y > y_grid THEN
                y = 0
                arbete = FALSE ;klar
                TYPE "Arbetet klart"
            END

        END ; Slut loop

.END

