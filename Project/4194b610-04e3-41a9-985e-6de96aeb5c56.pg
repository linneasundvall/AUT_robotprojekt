.PROGRAM main()
        CALL init() ; Tar in startvärden

; Locations till pickframe
        SET frame1[1] = jog_pick ; Location 1, Location 4
        SET frame1[2] = frame1[0]:TRANS(x_avs*x_gri) ;LOcation 2
        SET frame1[3] = frame1[0]:TRANS(,y_avs*y_gri) ; Location 3

; Skapar pickframe
        SET pickframe = FRAME(frame1[0],frame1[1],frame1[2],frame1[0])
; LOcations till placeframe
        SET frame2[1] = jog_place ; första, fjärde
        SET frame2[2] = frame2[0]:TRANS(x_avs*x_gri) ; andra
        SET frame2[3] = frame2[0]:TRANS(,y_avs*y_gri) ; tredje
; Skapar placeframe
        SET placeframe = FRAME(frame2[1],frame2[2],frame2[3],frame2[1])
; Loop
        WHILE arbete DO
            SET pick = pickframe:TRANS(x*x_avs,y*y_avs) ; Förskjutning från pickframe (origin)
            SET place = placeframe:TRANS(x*x_avs,y*y_avs) ; Förskjutning från placeframe (origin)


; Pick
            RIGHTY
            BREAK
            APPROS pick, 30
            CALL gripper(open)

            MOVE pick
            BREAK
            WAIT.EVENT 0.2
            CALL gripper(close)
            DEPART 30

;Labyrint Pick-Place
            FOR i = 0 TO 13
                MOVES loc[i]
                BREAK
                WAIT.EVENT 0.5
            END


; Place
            LEFTY
            BREAK

            APPRO place, 30

            MOVE place
            BREAK
            WAIT.EVENT 0.2
            CALL gripper(open)
            DEPART 30

; Labyrint Place-Pick

            FOR i = 13 TO 0 STEP -1
                MOVES loc[i]
                BREAK
                WAIT.EVENT 0.5
            END
; Uppräknare för förskjutning i X och Y axel för Pick/place-frame
            x = x+1
            IF x > x_grid THEN
                x = 0
                y = y+1
            END
            IF y > y_grid THEN
                y = 0
                arbete = FALSE ;klar
                TYPE "Arbetet klart"
            END

        END ; Slut loop

.END

