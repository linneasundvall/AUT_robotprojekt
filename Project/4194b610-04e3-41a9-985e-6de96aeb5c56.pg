.PROGRAM main()

        CALL init()




        SET frame1[0] = jog_pick ; första, fjärde
        SET frame1[1] = frame1[0]:TRANS(100) ; andra
        SET frame1[2] = frame1[0]:TRANS(,50) ; tredje


        SET pickframe = FRAME(frame1[0],frame1[1],frame1[2],frame1[0])

        SET frame2[0] = jog_place ; första, fjärde
        SET frame2[1] = frame2[0]:TRANS(100) ; andra
        SET frame2[2] = frame2[0]:TRANS(,50) ; tredje

        SET placeframe = FRAME(frame2[0],frame2[1],frame2[2],frame2[0])

        WHILE arbete DO
            SET pick = pickframe:TRANS(x*x_avs,y*y_avs)
            SET place = placeframe:TRANS(x*x_avs,y*y_avs)



            RIGHTY
            BREAK
            APPRO pick, 30
            CALL gripper(open)

            MOVE pick
            BREAK
            WAIT.EVENT 0.2
            CALL gripper(close)
            DEPART 30


            CALL maze()








            LEFTY
            BREAK

            APPRO place, 30

            MOVE place
            BREAK
            WAIT.EVENT 0.2
            CALL gripper(open)
            DEPART 30


            arbete = FALSE ; FÖr testning'

            x = x+1
            IF x > x_grid THEN
                x = 0
                y = y+1
            END
            IF y > y_grid THEN
                y = 0
                arbete = FALSE
                READY
            END

        END

.END

