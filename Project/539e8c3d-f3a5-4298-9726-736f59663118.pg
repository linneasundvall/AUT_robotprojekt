.PROGRAM init()

; Konstanter
        ATTACH ()
        SPEED 10 MONITOR
        SET gripper = TRANS(0,0,110)
        TOOL gripper
        y_avs = 25 ; korta sidan
        x_avs = 25 ; långa sidan
        x_grid = 4 ;5x3
        y_grid = 2
        open = TRUE
        close = FALSE

; Variabler
        x = 0
        y = 0
        arbete = TRUE





.END

