.PROGRAM init()
; Startvärden
        ATTACH ()
        SPEED 15 MONITOR
        SET gripper = TRANS(0,0,110)
        TOOL gripper
        arbete = TRUE
        x = 0
        y = 0


        x_avs = 25 ; långa sidan
        y_avs = 25 ; korta sidan
        x_grid = 2 ;3x5
        y_grid = 4
        open = TRUE
        close = FALSE
        CALL gripper(open)


.END

