.PROGRAM init()
; Startvärden
        ATTACH ()
        SPEED 15 MONITOR
        READY
        SET gripper = TRANS(0,0,90)
        TOOL gripper
        arbete = TRUE
        x = 0
        y = 0
        summa_x = 0
        summa_y = 0

        x_avs = 24.5 ; långa sidan
        y_avs = 25.5 ; korta sidan
        x_grid = 2
        y_grid = 4
        open = TRUE
        close = FALSE
        CALL gripper(open)


.END

