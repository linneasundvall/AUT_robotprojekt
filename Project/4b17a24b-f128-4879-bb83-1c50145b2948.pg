.PROGRAM test()
        ATTACH ()
        MOVE labyrint[0]
        BREAK
        WAIT.EVENT 0.2
        summa_y = -100
        summa_x = 0

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVE flytta
        BREAK
        WAIT.EVENT 0.2

        summa_y = summa_y+0
        summa_x = summa_x+100

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVE flytta
        BRAKE
        WAIT.EVENT 0.2

        summa_y = summa_y+(-50)
        summa_x = summa_x+0

        SET flytta = SHIFT(labyrint[0] BY summa_x,summa_y)
        MOVE flytta
        BREAK
        WAIT.EVENT 0.2
















.END

